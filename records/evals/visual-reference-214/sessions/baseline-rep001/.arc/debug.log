[2026-09-24T01:55:30.270+08:00] [TestDrivenDeveloper][REQ-1] tool-result> read_file result="content=\" 1  // REQ-1 frontend: shared session state. All pages (HomePage header included)\\n 2  // read current user from this context; loaded via GET /api/auth/me.\\n 3  import { createContext, useCallback, useContext, useEffect, useMemo, useState } from 'react';\\n 4  import { fetchCurrentUser, signOut } from '../register/registerApi';\\n 5  \\n 6  export interface SessionUser {\\n 7    id: string;\\n 8    username: string;\\n 9    email: string | null;\\n10    name: string;\\n11  }\\n12  \\n13  interface SessionState {\\n14    user: SessionUser | null;\\n15    loading: boolean;\\n16    refresh: () => Promise<void>;\\n17    signOut: () => Promise<void>;\\n18  }\\n19  \\n20  const SessionContext = createContext<SessionState | null>(null);\\n21  \\n22  export function SessionProvider({ children }: { children: React.ReactNode }) {\\n23    const [user, setUser] = useState<SessionUser | null>(null);\\n24    const [loading, setLoading] = useState(true);\\n25  \\n26    const refresh = useCallback(async () => {\\n27      try {\\n28        const account = await fetchCurrentUser();\\n29        setUser(account);\\n30      } finally {\\n31        setLoading(false);\\n32      }\\n33    }, []);\\n34  \\n35    const handleSignOut = useCallback(async () => {\\n36      await signOut();\\n37      setUser(null);\\n38    }, []);\\n39  \\n40    useEffect(() => {\\n41      void refresh();\\n42    }, [refresh]);\\n43  \\n44    const value = useMemo(() => ({ user, loading, refresh, signOut: handleSignOut }), [user, loading, refresh, handleSignOut]);\\n45    return <SessionContext.Provider value={value}>{children}</SessionContext.Provider>;\\n46  }\\n47  \\n48  export function useSession(): SessionState {\\n49    const ctx = useContext(SessionContext);\\n50    if (!ctx) throw new Error('useSession must be used within a SessionProvider');\\n51    return ctx;\\n52  }\" name='read_file' tool_call_id='call_dd46d17d0fc34270b573d1d8'"
[2026-09-24T01:55:30.271+08:00] [TestDrivenDeveloper][REQ-1] tool-result> read_file result="content=\" 1  // REQ-1 frontend API client for auth endpoints. Reuses the shared axios client.\\n 2  import apiClient from '../../api';\\n 3  \\n 4  export interface RegisterPayload {\\n 5    username: string;\\n 6    password: string;\\n 7    confirmPassword: string;\\n 8    idType: string;\\n 9    name: string;\\n10    idNumber: string;\\n11    passengerType: string;\\n12    email?: string;\\n13    countryCode: string;\\n14    phone: string;\\n15    agreement: boolean;\\n16  }\\n17  \\n18  export interface AuthFieldErrors {\\n19    [field: string]: string;\\n20  }\\n21  \\n22  export async function register(payload: RegisterPayload): Promise<{ ok: boolean; fields?: AuthFieldErrors }> {\\n23    try {\\n24      await apiClient.post('/api/auth/register', payload);\\n25      return { ok: true };\\n26    } catch (error) {\\n27      const response = (error as { response?: { data?: { fields?: AuthFieldErrors } } }).response;\\n28      if (response?.data?.fields) {\\n29        return { ok: false, fields: response.data.fields };\\n30      }\\n31      return { ok: false, fields: {} };\\n32    }\\n33  }\\n34  \\n35  export async function fetchCurrentUser(): Promise<{ id: string; username: string; email: string | null; name: string } | null> {\\n36    try {\\n37      const response = await apiClient.get('/api/auth/me');\\n38      return response.data?.account ?? null;\\n39    } catch (error) {\\n40      const status = (error as { response?: { status?: number } }).response?.status;\\n41      if (status === 401) return null;\\n42      return null;\\n43    }\\n44  }\\n45  \\n46  export async function signOut(): Promise<void> {\\n47    await apiClient.post('/api/auth/logout');\\n48  }\" name='read_file' tool_call_id='call_5467366eefb8414385c51e75'"
